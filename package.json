{
  "name": "paltools",
  "private": true,
  "version": "0.1.1",
  "description": "《幻兽帕鲁》本地图鉴与配种辅助工具",
  "author": "PalTools Contributors",
  "main": "script/electron/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run test:dev-provider && npm run test:electron-provider-protocol && npm run data:validate && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --maxWorkers=4",
    "test:changes": "node script/test-changes.mjs",
    "test:plan": "node script/test-changes.mjs --plan",
    "test:impact": "node --test script/test-impact.node.mjs",
    "test:verification": "node --test script/verification-session.node.mjs",
    "verify": "node script/verify.mjs",
    "test:browser": "node script/test-browser.mjs",
    "test:dev-provider": "node script/test-dev-provider.cjs && node --test script/test-dev-provider.node.cjs",
    "build:exe:web": "npm run build",
    "build:electron-provider-protocol": "node script/build-electron-provider-protocol.mjs",
    "test:electron-provider-protocol": "npm run build:electron-provider-protocol && node script/test-electron-provider-protocol.cjs",
    "package:electron": "node script/verify.mjs package-electron",
    "build:package:electron": "node script/verify.mjs --package",
    "smoke:electron": "node script/verify.mjs smoke",
    "verify:electron": "node script/verify.mjs --electron",
    "package:exe": "powershell -NoProfile -ExecutionPolicy Bypass -File script/package-exe.ps1",
    "package:mac:electron": "npm run test:electron-provider-protocol && electron-builder --mac dmg --arm64 --config.electronDist=node_modules/electron/dist",
    "package:mac": "node script/package-mac.mjs",
    "data:sync:pals": "tsx pipeline/data/paldb/sync.ts",
    "data:parse:pals": "tsx pipeline/data/paldb/sync.ts --offline",
    "data:import:breeding": "tsx pipeline/data/palcalc.ts",
    "data:build": "tsx pipeline/data/build.ts",
    "data:validate": "tsx pipeline/data/validate.ts",
    "data:sync": "npm run data:sync:pals && npm run data:import:breeding && npm run data:build && npm run data:validate",
    "docs:lint": "node script/lint-docs.mjs",
    "docs:lint:test": "node --test script/lint-docs.node.mjs",
    "check:node-scripts": "node --check script/build-cli.mjs && node --check script/build-electron-provider-protocol.mjs && node --check script/development/dev-provider.cjs && node --check script/electron/agent-gateway.cjs && node --check script/electron/main.cjs && node --check script/electron/preload.cjs && node --check script/lint-docs.mjs && node --check script/lint-docs.node.mjs && node --check script/agent-run-log.mjs && node --check script/agent-run-log.node.mjs && node --check script/report-agent-run.mjs && node --check script/log-agent-event.mjs && node --check script/package-mac.mjs && node --check script/prepare-electron-download.mjs && node --check script/test-impact.mjs && node --check script/test-impact.node.mjs && node --check script/test-changes.mjs && node --check script/verification-session.mjs && node --check script/verification-session.node.mjs && node --check script/verify.mjs && node --check script/test-browser.mjs && node --check script/test-dev-provider.cjs && node --check script/test-dev-provider.node.cjs && node --check script/test-electron-provider-protocol.cjs && node --check tests/e2e/paltools-browser-regression.js",
    "agent:log": "node script/log-agent-event.mjs",
    "agent:report": "node script/report-agent-run.mjs",
    "agent:log:test": "node --test script/agent-run-log.node.mjs",
    "samples:breeding-workspaces": "tsx script/generate-breeding-workspace-samples.ts",
    "cli": "tsx cli/main.ts",
    "cli:build": "node script/build-cli.mjs"
  },
  "devDependencies": {
    "@tanstack/react-virtual": "^3.14.9",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "@xyflow/react": "^12.11.2",
    "cheerio": "^1.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "elkjs": "^0.12.0",
    "esbuild": "~0.28.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "pinyin-pro": "^3.28.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.1",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "cn.paltools.desktop",
    "productName": "PalTools",
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "npmRebuild": false,
    "forceCodeSigning": false,
    "directories": {
      "output": "build/release",
      "buildResources": "script/electron/resources"
    },
    "files": [
      "build/web/**/*",
      "build/electron/provider-protocol.cjs",
      "script/electron/*.cjs",
      "package.json"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "PalTools-${version}-win-${arch}.${ext}"
    },
    "mac": {
      "icon": "icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "PalTools-${version}-mac-${arch}.${ext}"
    }
  }
}
